__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.env
.venv

# Node.js / Next.js
node_modules/
.next/
out/
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

