.vscode/
.idea/
*.swp
*.swo
*.exe

# Runtime data and compiler metadata
*.db
*.db-shm
*.db-wal
*.tsbuildinfo
gateway/uploads/
work/

# Go build cache (created by the local toolchain shim, not source)
.gocache/

# Runtime process bookkeeping and manual perf sampling, not source
gateway/gateway.pid
front/resource_monitor.csv

# Playwright per-run artifacts (traces, failure screenshots, .last-run.json).
# The last-run marker got committed once by accident in ebd2d90; keep them out.
front/test-results/
front/playwright-report/

# Bandit learning state is a runtime artifact derived from user feedback. It is
# machine-local and encodes behavioural data, so it must never be committed.
bandit_state.json
ai-service/bandit_state.json
ai-service/bandit_state.json.tmp
