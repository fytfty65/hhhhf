# AI provider (Qwen/DashScope compatible OpenAI endpoint)
APP_ENV=development
# Shared secret the gateway sends as X-Omni-Internal-Token. Auth is REQUIRED
# by default; leave blank only together with AI_SERVICE_ALLOW_ANONYMOUS=true
# for a purely local run.
AI_SERVICE_INTERNAL_TOKEN=
# Explicit opt-out of internal authentication. Never enable this on a host that
# is reachable from outside the machine.
AI_SERVICE_ALLOW_ANONYMOUS=false
# Bind address. Loopback by default so a missing firewall cannot expose the
# LLM-burning endpoints.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL_NAME=qwen-plus
LLM_EMBED_MODEL=text-embedding-v3
LLM_MAX_RETRIES=2

# Real travel data providers. Keys are injected at runtime and are never
# committed to the repository or written to logs.
AMAP_API_KEY=
SENIVERSE_API_KEY=
WORLDMONITOR_API_URL=https://api.worldmonitor.app
WORLDMONITOR_API_KEY=
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
NMC_ALERT_URL=

# Shared infrastructure
REDIS_URL=
CACHE_TTL=86400
CACHE_SIM_THRESHOLD=0.92
AI_BANDIT_ENABLED=false
AI_BANDIT_EXPLORATION_BUDGET=0.10
AI_BANDIT_ARMS=builtin-joint-v1
