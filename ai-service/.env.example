# AI provider (Qwen/DashScope compatible OpenAI endpoint)
APP_ENV=development
# Shared secret the gateway sends as X-Omni-Internal-Token. Auth is REQUIRED
# by default; leave blank only together with AI_SERVICE_ALLOW_ANONYMOUS=true
# for a purely local run.
AI_SERVICE_INTERNAL_TOKEN=
# Explicit opt-out of internal authentication. Never enable this on a host that
# is reachable from outside the machine.
AI_SERVICE_ALLOW_ANONYMOUS=false
# Bind address. Loopback by default so a missing firewall cannot expose the
# LLM-burning endpoints.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 默认 qwen-turbo：同题对照实测（3 个真实场景、清缓存冷跑）路线与门禁结论和 qwen-plus
# 完全一致，单次主推演耗时约为其 1/2（41-52s vs 87-122s）。
# 想换更强/更慢的模型：qwen-plus；也可整体切到别的 OpenAI 兼容端点（DeepSeek、本地 Ollama）。
LLM_MODEL_NAME=qwen-turbo
# 视觉模型只用于「参考路线截图 → 文字」。必须单独配：主模型是纯文本模型，
# 拿它读图会直接报错。留空则回退 core/llm_config.DEFAULT_VISION_MODEL。
LLM_VISION_MODEL=qwen-vl-max
LLM_EMBED_MODEL=text-embedding-v3
LLM_MAX_RETRIES=2

# Real travel data providers. Keys are injected at runtime and are never
# committed to the repository or written to logs.
AMAP_API_KEY=
SENIVERSE_API_KEY=

# --- 酒店实时房价：供应商只读 MCP（RollingGo，与 gateway/.env 同一把钥匙）---
# 有这把钥匙才拿得到**真房价**：实测 searchHotels 返回「1晚总价：131CNY」+ 可点开的
# bookingUrl（这正是"高德不提供房价"的缺口）。只读白名单写死在
# core/rollinggo_mcp.READ_ONLY_TOOLS（只有 searchHotels/getHotelDetail），绝不下单/取消。
# 留空 → 供应商保持 not_configured，方案里如实写"需要你确认"，不假装查过。
ROLLINGGO_API_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_API_KEY=
ROLLINGGO_MCP_ENABLED=1
# 单次查询超时与每次最多取几家（酒店名检索命中率不稳定，所以还会补一次城市检索）
ROLLINGGO_MCP_TIMEOUT_SECONDS=12
ROLLINGGO_MCP_MAX_HOTELS=5
WORLDMONITOR_API_URL=https://api.worldmonitor.app
WORLDMONITOR_API_KEY=
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
NMC_ALERT_URL=

# --- 联网取价 / 取简介（2026-10-07 重排搜索源，并把票务平台纳入"其他数据源"）---
# 提供方顺序：ddgs（DuckDuckGo 新包，实测唯一"搜得到又不要验证码"的通用源）→ bing
# （不弹验证码，且结果里带 .gov.cn —— 官方页面那条链路靠它）→ baidu/sogou（现在分别是
# 安全验证页/验证码页，仅作兜底）→ search（旧 ddg 包）。装了 `ddgs` 才有效。
WEB_PRICE_PROVIDERS=ddgs,bing,baidu,sogou,search,official_page
# 单次搜索/抓页超时（秒）
WEB_PRICE_TIMEOUT_SECONDS=6
# 一次规划里"联网取价"的总预算（秒）。2026-10-07 由 45 提到 90：取价改成多源合并
# （一个节点问 ddgs + Bing），单点成本翻倍；而且"预算不够"不再被语义缓存固化。
WEB_PRICE_BUDGET_SECONDS=90
# 每日请求上限。2026-10-07 由 120 提到 240：多源合并后一个节点要 2 次请求。
WEB_PRICE_DAILY_MAX_REQUESTS=240
# 白名单：政府/景区官网域名（逗号分隔，**人工确认过**才加）。票务平台（携程/去哪儿等）
# 由代码内置识别，标为 `platform`：有出处但非官方，不计入"可核实合计"。
WEB_PRICE_HOST_SUFFIXES=
# 允许直抓任意域名（默认关；开了就等于把"可核实"三个字废掉，别开）
WEB_PRICE_ALLOW_ANY_HOST=0
# 只给联网搜索用的代理（不要把高德流量带出国）
WEB_SEARCH_PROXY=

# Shared infrastructure
REDIS_URL=
CACHE_TTL=86400
CACHE_SIM_THRESHOLD=0.92
AI_BANDIT_ENABLED=false
AI_BANDIT_EXPLORATION_BUDGET=0.10
AI_BANDIT_ARMS=builtin-joint-v1
