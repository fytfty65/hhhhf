[Unit]
Description=OmniRoute offline model evaluation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=omniroute
Group=omniroute
WorkingDirectory=/opt/omniroute/ai-service
EnvironmentFile=/etc/omniroute/ai-service.env
ExecStart=/opt/omniroute/ai-service/venv/bin/python -m tools.run_model_evaluation --db /var/lib/omniroute/omniroute.db
TimeoutStartSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omniroute /var/log/omniroute

[Install]
WantedBy=multi-user.target
