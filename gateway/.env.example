# HTTP service
PORT=8080
APP_ENV=development
DB_PATH=./data/omniroute.db
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
DB_AUTO_BACKUP=false
DB_BACKUP_INTERVAL_MINUTES=0
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret for gateway -> AI service calls. Set the same value in the
# AI service environment; never commit the real token.
AI_SERVICE_INTERNAL_TOKEN=
# Optional gateway-side provider key for POI search. Leave blank when all
# provider calls are delegated to the AI service.
AMAP_API_KEY=
# Optional provider adapters. Each endpoint accepts the canonical planning
# context and returns {"options":[...]} or the shared response envelope.
TRANSPORT_PROVIDER_URL=
TRANSPORT_PROVIDER_TOKEN=
TRANSPORT_PROVIDER_NAME=
SCENIC_PROVIDER_URL=
SCENIC_PROVIDER_TOKEN=
SCENIC_PROVIDER_NAME=
# Vendor aliases: set an HTTPS API URL separately from the secret. The
# planner will use these only when the corresponding *_API_URL is present.
# ROLLINGGO_API_URL=https://mcp.rollinggo.ai/mcp
# ROLLINGGO_API_URL=https://mcp.rollinggo.cn/mcp  # domestic fallback
ROLLINGGO_API_URL=
ROLLINGGO_API_KEY=
ROLLINGGO_API_TOKEN=
ROLLINGGO_PROVIDER_NAME=RollingGo
ROLLINGGO_PROVIDER_PROTOCOL=mcp
# TUNIU_API_URL=https://openapi.tuniu.cn/mcp/train  # choose hotel/flight/train/ticket per domain
TUNIU_API_URL=
TUNIU_HOTEL_API_URL=https://openapi.tuniu.cn/mcp/hotel
TUNIU_FLIGHT_API_URL=https://openapi.tuniu.cn/mcp/flight
TUNIU_TRAIN_API_URL=https://openapi.tuniu.cn/mcp/train
TUNIU_TICKET_API_URL=https://openapi.tuniu.cn/mcp/ticket
TUNIU_API_KEY=
TUNIU_API_TOKEN=
TUNIU_PROVIDER_NAME=Tuniu
TUNIU_PROVIDER_PROTOCOL=mcp
# TRIPCOM_API_URL=  # official authorized MCP/API endpoint only; do not use www.trip.com HTML
TRIPCOM_API_URL=
TRIPCOM_API_KEY=
TRIPCOM_API_TOKEN=
TRIPCOM_PROVIDER_NAME=Trip.com
TRIPCOM_PROVIDER_PROTOCOL=mcp
LODGING_PROVIDER_URL=
LODGING_PROVIDER_TOKEN=
LODGING_PROVIDER_NAME=
DINING_PROVIDER_URL=
DINING_PROVIDER_TOKEN=
DINING_PROVIDER_NAME=
WEATHER_PROVIDER_URL=
WEATHER_PROVIDER_TOKEN=
CROWD_PROVIDER_URL=
CROWD_PROVIDER_TOKEN=
# Maximum allowed member-utility standard deviation before a repair/reselect
# proposal is emitted in the joint planning response.
PLANNING_FAIRNESS_MAX_STD=0.15
# Comma-separated user IDs allowed to register/promote planning models.
PLANNING_ADMIN_USER_IDS=
# Registered model endpoints are stored per deployment (not in env) and are
# called only for active/canary/shadow versions after admin approval.
# Secret salt used to HMAC identifiers in offline dataset exports.
PLANNING_DATASET_HASH_SALT=
# Set in production to share auth sessions across gateway instances.
# Leave empty only for local single-process development.
REDIS_URL=redis://localhost:6379/0

# Comma-separated exact browser origins. Never use '*' with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3101,http://127.0.0.1:3101,http://localhost:3106,http://127.0.0.1:3106,http://localhost:3107,http://127.0.0.1:3107,http://localhost:3110,http://127.0.0.1:3110,http://localhost:3120,http://127.0.0.1:3120,http://localhost:3130,http://127.0.0.1:3130
